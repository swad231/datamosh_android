<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, about 3x1 cells: cover, title/artist with the DATAMOSH mark, like and play/pause. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Square: the height follows the widget, the width follows the height. -->
    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:background="@drawable/widget_cover_bg"
        android:clipToOutline="true"
        android:contentDescription="Обложка"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_apk" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="DATAMOSH FM"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="26dp"
                android:layout_height="19dp"
                android:layout_marginStart="8dp"
                android:contentDescription="DATAMOSH"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_fm" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Радио"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_like"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Лайк">

                <ImageView
                    android:id="@+id/widget_like_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_heart_border" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_play"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Слушать">

                <ImageView
                    android:id="@+id/widget_play_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_play" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
